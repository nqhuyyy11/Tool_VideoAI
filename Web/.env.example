# Sao chép file này thành ".env" rồi điền giá trị thật.
# KHÔNG đưa file .env lên GitHub, KHÔNG gửi cho người khác.

# --- Supabase (lấy ở Dashboard -> Project Settings -> API Keys / Data API) ---
# Project URL, dạng https://abcdefgh.supabase.co
SUPABASE_URL=
# Key công khai: "anon public" (kiểu cũ) hoặc "Publishable key" (kiểu mới)
SUPABASE_ANON_KEY=
# Key bí mật: "service_role" (kiểu cũ) hoặc "Secret key" (kiểu mới). Chỉ backend dùng.
SUPABASE_SERVICE_ROLE_KEY=

# Tên bucket chứa video
SUPABASE_BUCKET=videos
# Giới hạn dung lượng mỗi file (MB). Gói Free của Supabase là 50.
MAX_UPLOAD_MB=50

# --- Tool gốc ---
# Thư mục chứa script_gen.py, tts.py, footage.py, render.py
AUTOVIDEO_DIR=../autovideo

# Key Gemini / Pexels / Pixabay: nếu để trống, web dùng key trong thư mục tool gốc
# (autovideo/.env). Khi đưa lên host thì điền vào đây hoặc vào phần
# Environment Variables của host.
# GEMINI_API_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
